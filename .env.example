# ============================================================
# 论文阅读助手 — 环境变量模板
# 复制此文件为 .env 并填入实际值
#   Windows: copy .env.example .env
#   Mac/Linux: cp .env.example .env
# ============================================================

# ---------- LLM / Embedding ----------
# ⚠️ 密钥变量名是 PAPERLENS_API_KEY，不是 OPENAI_API_KEY。
# 原因：系统级环境变量的优先级高于 .env，而 OPENAI_API_KEY 极易被其它 AI 工具
# 设成系统级变量，从而静默覆盖这里。改名后就不会被误伤。
# （仍保留 OPENAI_API_KEY 作为兼容回退，两者都写时 PAPERLENS_ 优先。）
PAPERLENS_API_KEY=sk-your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
# 聊天模型
LLM_MODEL_NAME=gpt-3.5-turbo
# 温度：论文问答建议 0.2~0.3（少发挥）；综述/头脑风暴可调到 0.5
LLM_TEMPERATURE=0.3
# 嵌入模型
EMBEDDING_MODEL_NAME=text-embedding-ada-002

# 嵌入后端：openai（走 OPENAI_BASE_URL 的 /embeddings）
#           huggingface（本地 sentence-transformers 推理，不消耗额度）
EMBEDDING_PROVIDER=openai

# ---------- MySQL ----------
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=kb_copilot_2026
MYSQL_DATABASE=kb_copilot

# ---------- FastAPI ----------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# 日志级别: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# 日志目录（按天分文件 + 10MB 轮转，保留 7 天）
LOG_DIR=./logs

# ---------- Streamlit ----------
# 仅 Docker 部署需要（容器内用服务名访问后端）。
# 本地开发不要设置这个变量，用默认值 http://127.0.0.1:8000 即可。
# （注意是 127.0.0.1 不是 localhost——后者在 Windows 上会走 IPv6 回退，单次 +400ms）
BACKEND_URL=http://backend:8000

# ---------- 文档处理 ----------
# 切分大小（字符）。bge 类模型 512 token 上限，中文建议不超过 450
CHUNK_SIZE=500
CHUNK_OVERLAP=50
# 单次问答检索的片段数
RETRIEVER_TOP_K=4
# 入库前过滤参考文献/致谢/页眉页脚
FILTER_REFERENCES=true
# 章节感知检索（问题意图 → 章节加权）
SECTION_AWARE_RETRIEVAL=true
# 单文件上传上限（MB），0 表示不限制
MAX_UPLOAD_MB=50

# ---------- 两阶段检索（cross-encoder 重排） ----------
RERANK_ENABLED=true
RERANK_MODEL=BAAI/bge-reranker-base
# 参与重排的候选数：太小重排没意义，太大 CPU 上会变慢
RERANK_CANDIDATES=30

# ---------- 跨文献对比 ----------
# 一次最多对比几篇
COMPARE_MAX_DOCUMENTS=4
# 每篇论文取几段参与对比
COMPARE_CHUNKS_PER_DOC=4
# 对比上下文的总字符预算，超出按篇数均分后截断
COMPARE_MAX_CONTEXT_CHARS=12000
# 未指定对比维度时默认对齐的章节: abstract/introduction/method/experiment/conclusion
COMPARE_DEFAULT_SECTION=method

# ---------- 文件存储路径 ----------
UPLOAD_DIR=./data/uploads
VECTOR_STORE_DIR=./data/vector_store

# ---------- HuggingFace 模型下载 / 离线 ----------
# 这三个变量不在 config.py 里，由 huggingface_hub / transformers 直接读进程环境，
# 且只在模块导入时求值一次；backend/__init__.py 会用 load_dotenv() 把 .env 注入，
# 所以写在这里就能生效。
#
# 模型已缓存后设为 1：禁止联网核对。国内连不上 huggingface.co，不设的话每次加载
# 都会卡 5 次退避重试（1s/2s/4s/8s/16s），启动白等半分钟以上。
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
# 需要下载新模型时：上面两项改回 0，并启用国内镜像
# HF_ENDPOINT=https://hf-mirror.com
